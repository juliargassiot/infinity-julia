#!/bin/sh
checker="$(dirname "$0")/../check_docs.py"
for python in python3 python "py -3"; do
    if $python -c "import sys; sys.exit(sys.version_info < (3, 9))" 2>/dev/null; then
        exec $python "$checker" "$@"
    fi
done
echo "Python 3 was not found, so the documentation rules cannot be checked." >&2
exit 2
