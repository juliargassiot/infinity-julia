config_version=5

[application]

config/name="Infinity Julia"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

Readout="*res://readout.gd"

[display]

window/size/mode.deck=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input]

toggle_readout={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194334)]
}
move_left={
"deadzone": 0.2,
"events": [Object(InputEventJoypadMotion,"device":-1,"axis":0,"axis_value":-1.0), Object(InputEventKey,"device":-1,"physical_keycode":65)]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventJoypadMotion,"device":-1,"axis":0,"axis_value":1.0), Object(InputEventKey,"device":-1,"physical_keycode":68)]
}
